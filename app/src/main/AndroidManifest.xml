<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      LibraryApplication:
      - Custom Application class instantiated before any activity or service.
      - Holds the AppContainer for manual dependency injection.
    -->
    <application
        android:allowBackup="true"
        android:name=".LibraryApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibraryManagement">

        <!--
          MainActivity:
          - Single-activity entry point hosting Compose NavHost.
          - Exported with MAIN and LAUNCHER filters to show in the app drawer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LibraryManagement">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Note: No <provider> for FileProvider is needed.
          Image capture uses ActivityResultContracts.TakePicturePreview(), which returns
          a Bitmap directly to the app without requiring content URIs or file provider configuration.
        -->
    </application>

</manifest>